# Full-cycle integration test, driven entirely through the debug commands so it
# does not have to wait out real timers. Every assertion prints OK or FAIL.

# --- Infrastructure exists and is immutable ---------------------------------
/tax-build
/silent-command local s=game.surfaces.nauvis; local n=#s.find_entities_filtered{name="straight-rail"}; rcon.print(n > 20 and ("OK rails="..n) or ("FAIL rails="..n))
/silent-command local s=game.surfaces.nauvis; local st=s.find_entities_filtered{name="train-stop"}[1]; rcon.print((st and st.backer_name=="Tax Station") and "OK station-named" or ("FAIL station="..tostring(st and st.backer_name)))
/silent-command local s=game.surfaces.nauvis; local r=s.find_entities_filtered{name="straight-rail"}[1]; rcon.print((r.destructible==false and r.minable==false) and "OK rail-immutable" or "FAIL rail-mutable")
/silent-command local s=game.surfaces.nauvis; local st=s.find_entities_filtered{name="train-stop"}[1]; rcon.print((st.destructible==false and st.minable==false) and "OK stop-immutable" or "FAIL stop-mutable")
/silent-command local s=game.surfaces.nauvis; local r=s.find_entities_filtered{name="straight-rail"}[1]; local before=r.valid; r.damage(1000, game.forces.enemy); rcon.print((before and r.valid) and "OK rail-survives-damage" or "FAIL rail-destroyed-by-damage")

# --- Demand generation tracks the tech tree ---------------------------------
/tax-cycle 0
/tax-demand 0
/silent-command local d=storage.taxes.demand; rcon.print((d and #d>0) and ("OK demand-generated n="..#d) or "FAIL demand-empty")
/silent-command local d=storage.taxes.demand; local ok=true; for _,e in pairs(d) do if not (prototypes.item[e.name] or prototypes.fluid[e.name]) then ok=false end end; rcon.print(ok and "OK demand-prototypes-valid" or "FAIL demand-has-unknown-prototype")
/silent-command local d=storage.taxes.demand; local seen,ok={},true; for _,e in pairs(d) do if seen[e.name] then ok=false end seen[e.name]=true end; rcon.print(ok and "OK demand-distinct" or "FAIL demand-has-duplicates")
/silent-command local f=game.forces.player; local n=0; for _,t in pairs(f.technologies) do if t.researched then n=n+1 end end; rcon.print("PROBE researched="..n)

# --- Train spawns, is filtered, and is immutable -----------------------------
/tax-train
/silent-command local s=game.surfaces.nauvis; local n=#s.find_entities_filtered{name={"locomotive","cargo-wagon","fluid-wagon"}}; rcon.print(n>0 and ("OK train-spawned stock="..n) or "FAIL train-not-spawned")
/tax-arrive
/silent-command rcon.print(storage.taxes.phase=="loading" and "OK phase-loading" or ("FAIL phase="..storage.taxes.phase))
/silent-command local s=game.surfaces.nauvis; local w=s.find_entities_filtered{name="cargo-wagon"}[1]; if not w then rcon.print("PROBE no-cargo-wagon (fluid-only demand)") else local inv=w.get_inventory(defines.inventory.cargo_wagon); local unfiltered=0; for i=1,#inv do if not inv.get_filter(i) then unfiltered=unfiltered+1 end end; rcon.print(unfiltered==0 and "OK all-slots-filtered" or ("FAIL unfiltered-slots="..unfiltered)) end
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive"}[1]; rcon.print((l and l.destructible==false and l.minable==false) and "OK loco-immutable" or "FAIL loco-mutable")

# --- Paying in full costs nothing -------------------------------------------
/tax-fill 1
/silent-command local paid_before=storage.taxes.stats.paid; storage.taxes._paid_before=paid_before; rcon.print("PROBE paid_before="..paid_before)
/tax-settle
/silent-command rcon.print(storage.taxes.stats.paid==storage.taxes._paid_before+1 and "OK paid-in-full" or ("FAIL paid="..storage.taxes.stats.paid.." expected="..(storage.taxes._paid_before+1)))
/silent-command rcon.print(storage.taxes.stats.waves==0 and "OK no-wave-when-paid" or ("FAIL waves="..storage.taxes.stats.waves))
/tax-despawn

# --- Underpaying triggers a proportional wave --------------------------------
/tax-cycle 6
/tax-demand 6
/tax-train
/tax-arrive
/tax-fill 0.5
/silent-command local n=0; for _,e in pairs(game.surfaces.nauvis.find_entities_filtered{force="enemy",type="unit"}) do n=n+1 end; storage.taxes._enemies_before=n; rcon.print("PROBE enemies_before="..n)
/tax-settle
/silent-command rcon.print(storage.taxes.stats.waves>0 and ("OK wave-spawned waves="..storage.taxes.stats.waves) or "FAIL no-wave-on-shortfall")
/silent-command local n=0; for _,e in pairs(game.surfaces.nauvis.find_entities_filtered{force="enemy",type="unit"}) do n=n+1 end; rcon.print(n>storage.taxes._enemies_before and ("OK enemies-added "..storage.taxes._enemies_before.." -> "..n) or ("FAIL enemies "..storage.taxes._enemies_before.." -> "..n))

# --- Escalation --------------------------------------------------------------
/silent-command local a=0; for _,e in pairs(storage.taxes.demand) do a=a+e.count end; storage.taxes._d6=a; rcon.print("PROBE demand_total_cycle6="..a)
/tax-cycle 0
/tax-demand 0
/silent-command local a=0; for _,e in pairs(storage.taxes.demand) do a=a+e.count end; rcon.print("PROBE demand_total_cycle0="..a)


/tax-status
