# Probe the 2.0 LuaSchedule interface and rail geometry on prepared terrain.
/silent-command local s=game.surfaces.nauvis; local t={}; for x=-60,60 do for y=-36,-26 do t[#t+1]={name="grass-1",position={x,y}} end end; s.set_tiles(t); for _,e in pairs(s.find_entities_filtered{area={{-62,-38},{62,-24}},type={"tree","simple-entity","cliff"}}) do e.destroy() end; rcon.print("PROBE terrain-ready")
/silent-command local s=game.surfaces.nauvis; local n,f=0,{}; for x=-39,39,2 do local r=s.create_entity{name="straight-rail",position={x,-31},direction=defines.direction.east,force=game.forces.player}; if r then n=n+1 else f[#f+1]=x end end; rcon.print("PROBE odd-grid rails="..n.." failed="..table.concat(f,","))
/silent-command local s=game.surfaces.nauvis; local st=s.create_entity{name="train-stop",position={3,-33},direction=defines.direction.east,force=game.forces.player}; if st then st.backer_name="Tax Station" end; rcon.print("PROBE stop="..tostring(st~=nil))
/silent-command local s=game.surfaces.nauvis; local l=s.create_entity{name="locomotive",position={-31,-31},direction=defines.direction.east,force=game.forces.player}; rcon.print("PROBE loco="..tostring(l~=nil).." pos="..(l and (l.position.x..","..l.position.y) or "nil"))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; local sc=l.train.get_schedule(); local names={}; for _,m in ipairs{"add_record","remove_record","get_record","clear_records","get_record_count","go_to_station","current","set_stopped","drag_record"} do names[#names+1]=m..":"..type(sc[m]) end; rcon.print("PROBE sched "..table.concat(names," "))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; local sc=l.train.get_schedule(); local ok,err=pcall(function() sc.add_record{station="Tax Station"} end); rcon.print("PROBE add_record ok="..tostring(ok).." err="..tostring(err).." count="..tostring(sc.get_record_count and sc.get_record_count()))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; l.train.manual_mode=false; rcon.print("PROBE manual_mode="..tostring(l.train.manual_mode).." state="..tostring(l.train.state))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; local sc=l.train.get_schedule(); local ok,rec=pcall(function() return sc.get_record{schedule_index=1} end); rcon.print("PROBE get_record ok="..tostring(ok).." json="..tostring(ok and helpers.table_to_json(rec) or rec))
/silent-command local s=game.surfaces.nauvis; local w=s.create_entity{name="cargo-wagon",position={-25,-31},direction=defines.direction.east,force=game.forces.player}; local inv=w.get_inventory(defines.inventory.cargo_wagon); inv.set_filter(1,"iron-plate"); rcon.print("PROBE wagon-slots="..#inv.." filter1="..helpers.table_to_json(inv.get_filter(1)))
/silent-command local s=game.surfaces.nauvis; local fw=s.create_entity{name="fluid-wagon",position={-19,-31},direction=defines.direction.east,force=game.forces.player}; rcon.print("PROBE fluid-wagon="..tostring(fw~=nil).." cap="..tostring(fw and fw.prototype.fluid_capacity))
/silent-command rcon.print("PROBE train-count="..#game.surfaces.nauvis.get_trains())
