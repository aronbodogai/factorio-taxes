# The two hardest fixes, tested with a hand-built demand so the assertions do
# not depend on what the random draw happens to pick:
#   - shortfall must be the mean of per-entry shortfalls, so one huge fluid
#     cannot drown out a completely unpaid item
#   - each fluid wagon must be bound to one fluid, so a second demanded fluid
#     is always payable
/tax-build

# --- A mixed item and fluid demand, paid on the fluid side only --------------
/silent-command storage.taxes.cycle=0; storage.taxes.settled_cycle=nil; storage.taxes.demand={{kind="item",name="iron-plate",count=100,delivered=0},{kind="fluid",name="water",count=25000,delivered=0}}; rcon.print("PROBE demand-set iron-plate 100 + water 25000")
/tax-train
/tax-arrive
/silent-command local s=game.surfaces.nauvis; rcon.print("PROBE stock cargo="..#s.find_entities_filtered{name="cargo-wagon"}.." fluid="..#s.find_entities_filtered{name="fluid-wagon"})
/silent-command local s=game.surfaces.nauvis; local fw=s.find_entities_filtered{name="fluid-wagon"}[1]; rcon.print(fw and "OK fluid-wagon-present" or "FAIL no-fluid-wagon-for-fluid-demand")
/silent-command local s=game.surfaces.nauvis; local fw=s.find_entities_filtered{name="fluid-wagon"}[1]; local f=fw and fw.fluidbox and fw.fluidbox.get_filter(1); rcon.print((f and f.name=="water") and "OK fluid-wagon-filtered-to-water" or ("FAIL fluid-filter="..tostring(f and f.name)))
# Pay the fluid in full, pay nothing of the item.
/silent-command local s=game.surfaces.nauvis; local fw=s.find_entities_filtered{name="fluid-wagon"}[1]; fw.insert_fluid{name="water",amount=25000}; rcon.print("PROBE water-loaded="..math.floor(fw.get_fluid_count("water")))
/silent-command local s=game.surfaces.nauvis; local c=0; for _,w in pairs(s.find_entities_filtered{name="cargo-wagon"}) do local inv=w.get_inventory(defines.inventory.cargo_wagon); for i=1,#inv do local st=inv[i]; if st.valid_for_read then c=c+st.count end end end; rcon.print(c==0 and "OK item-side-unpaid" or ("FAIL item-side-has="..c))
/tax-settle
/silent-command local sf=storage.taxes.stats.last_shortfall; rcon.print((sf>0.45 and sf<0.55) and ("OK mean-shortfall="..string.format("%.3f",sf)) or ("FAIL shortfall="..string.format("%.3f",sf).." expected ~0.5 (item fully unpaid, fluid fully paid)"))
/tax-despawn

# --- Two different fluids must each get their own wagon ----------------------
/silent-command local f=game.forces.player; for _,t in pairs({"fluid-handling","oil-gathering","oil-processing","advanced-oil-processing","lubricant"}) do if f.technologies[t] then f.technologies[t].researched=true end end; rcon.print("PROBE oil-tech-researched")
/silent-command storage.taxes.cycle=0; storage.taxes.settled_cycle=nil; storage.taxes.demand={{kind="fluid",name="light-oil",count=20000,delivered=0},{kind="fluid",name="heavy-oil",count=20000,delivered=0}}; rcon.print("PROBE demand-set light-oil + heavy-oil")
/tax-train
/tax-arrive
/silent-command local s=game.surfaces.nauvis; local fw=s.find_entities_filtered{name="fluid-wagon"}; rcon.print(#fw>=2 and ("OK two-fluid-wagons="..#fw) or ("FAIL fluid-wagons="..#fw.." for two fluids"))
/silent-command local s=game.surfaces.nauvis; local seen={}; for _,w in pairs(s.find_entities_filtered{name="fluid-wagon"}) do local f=w.fluidbox and w.fluidbox.get_filter(1); if f then seen[f.name]=(seen[f.name] or 0)+1 end end; local parts={}; for k,v in pairs(seen) do parts[#parts+1]=k.."="..v end; table.sort(parts); rcon.print("PROBE fluid-filters "..table.concat(parts," "))
/silent-command local s=game.surfaces.nauvis; local seen={}; for _,w in pairs(s.find_entities_filtered{name="fluid-wagon"}) do local f=w.fluidbox and w.fluidbox.get_filter(1); if f then seen[f.name]=true end end; rcon.print((seen["light-oil"] and seen["heavy-oil"]) and "OK both-fluids-have-a-wagon" or "FAIL a-demanded-fluid-has-no-wagon")
# The engine must refuse the wrong fluid in a filtered wagon.
/silent-command local s=game.surfaces.nauvis; local w; for _,c in pairs(s.find_entities_filtered{name="fluid-wagon"}) do local f=c.fluidbox and c.fluidbox.get_filter(1); if f and f.name=="light-oil" then w=c end end; if w then w.insert_fluid{name="heavy-oil",amount=5000} end; rcon.print((w and math.floor(w.get_fluid_count("heavy-oil"))==0) and "OK wrong-fluid-rejected" or ("FAIL wrong-fluid-accepted="..tostring(w and w.get_fluid_count("heavy-oil"))))

# --- Settling twice must not double-count ------------------------------------
/silent-command storage.taxes.demand={{kind="item",name="iron-plate",count=50,delivered=0}}; storage.taxes.settled_cycle=nil; rcon.print("PROBE demand-reset")
/tax-fill 1
/tax-settle
/silent-command storage.taxes._c=storage.taxes.cycle; storage.taxes._p=storage.taxes.stats.paid; storage.taxes._w=storage.taxes.stats.waves; rcon.print("PROBE after-first-settle cycle="..storage.taxes._c.." paid="..storage.taxes._p.." waves="..storage.taxes._w)
/tax-settle
/silent-command local t=storage.taxes; rcon.print(t.cycle==t._c and ("OK cycle-not-double-counted="..t.cycle) or ("FAIL cycle "..t._c.." -> "..t.cycle))
/silent-command local t=storage.taxes; rcon.print(t.stats.waves==t._w and "OK no-phantom-wave-on-resettle" or ("FAIL waves "..t._w.." -> "..t.stats.waves))
/silent-command local t=storage.taxes; rcon.print(t.stats.paid==t._p and "OK paid-not-double-counted" or ("FAIL paid "..t._p.." -> "..t.stats.paid))
