# Empirical probe of the two riskiest 2.0 APIs: straight-rail placement geometry
# and the LuaTrain schedule interface. Not an assertion suite; it prints facts.
/silent-command local s=game.surfaces.nauvis; local out={}; for x=-4,4 do local p={x=x,y=-32}; local ok=s.can_place_entity{name="straight-rail",position=p,direction=defines.direction.east,force=game.forces.player}; out[#out+1]=x..":"..tostring(ok) end; rcon.print("PROBE railpos "..table.concat(out," "))
/silent-command rcon.print("PROBE dir east="..defines.direction.east.." north="..defines.direction.north)
/silent-command local s=game.surfaces.nauvis; local t={}; for x=-40,40,2 do t[#t+1]={name="grass-1",position={x,-33}} t[#t+1]={name="grass-1",position={x,-32}} t[#t+1]={name="grass-1",position={x,-31}} t[#t+1]={name="grass-1",position={x,-34}} end; s.set_tiles(t); rcon.print("PROBE tiles-set")
/silent-command local s=game.surfaces.nauvis; for _,e in pairs(s.find_entities_filtered{area={{-42,-38},{42,-26}}, type={"tree","simple-entity","cliff"}}) do e.destroy() end; rcon.print("PROBE corridor-cleared")
/silent-command local s=game.surfaces.nauvis; local n=0; for x=-40,40,2 do local r=s.create_entity{name="straight-rail",position={x,-32},direction=defines.direction.east,force=game.forces.player} if r then n=n+1 end end; rcon.print("PROBE rails-created="..n)
/silent-command local s=game.surfaces.nauvis; local r=s.find_entities_filtered{name="straight-rail",limit=3}; local out={}; for _,e in pairs(r) do out[#out+1]=e.position.x..","..e.position.y end; rcon.print("PROBE rail-positions "..table.concat(out," "))
/silent-command local s=game.surfaces.nauvis; local l=s.create_entity{name="locomotive",position={0,-32},direction=defines.direction.east,force=game.forces.player}; rcon.print("PROBE loco="..tostring(l~=nil))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; local t=l and l.train; rcon.print("PROBE train="..tostring(t~=nil).." schedule_field="..type(t and rawget(t,"schedule") or nil).." get_schedule="..type(t and t.get_schedule))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; local t=l.train; local ok,err=pcall(function() return t.schedule end); rcon.print("PROBE t.schedule ok="..tostring(ok).." val="..tostring(err))
/silent-command local s=game.surfaces.nauvis; local l=s.find_entities_filtered{name="locomotive",limit=1}[1]; local t=l.train; local ok,sched=pcall(function() return t.get_schedule() end); rcon.print("PROBE get_schedule ok="..tostring(ok).." type="..type(sched))
/silent-command local s=game.surfaces.nauvis; local st=s.create_entity{name="train-stop",position={2,-34},direction=defines.direction.east,force=game.forces.player}; if st then st.backer_name="Tax Station" end; rcon.print("PROBE stop="..tostring(st~=nil).." name="..tostring(st and st.backer_name))
/silent-command local s=game.surfaces.nauvis; local w=s.create_entity{name="cargo-wagon",position={-8,-32},direction=defines.direction.east,force=game.forces.player}; local inv=w and w.get_inventory(defines.inventory.cargo_wagon); local ok,err=pcall(function() inv.set_filter(1,"iron-plate") end); rcon.print("PROBE wagon="..tostring(w~=nil).." setfilter_ok="..tostring(ok).." err="..tostring(err).." filter1="..tostring(inv and inv.get_filter(1)))
/silent-command rcon.print("PROBE evo="..tostring(game.forces.enemy.get_evolution_factor(game.surfaces.nauvis)))
